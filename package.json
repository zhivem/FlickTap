{
  "name": "movie-search-app",
  "version": "1.0.5",
  "description": "Приложение для поиска и просмотра фильмов",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.zhive.movieapp",
    "productName": "FlickTap",
    "copyright": "Copyright © 2025 Zhivem",
    "compression": "maximum",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": ["portable"],
      "icon": "assets/movie.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      ".env",
      "!assets/**/*.psd",
      "!assets/**/*.ai"
    ]
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.13.1",
    "axios": "^1.13.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2"
  },
  "author": "Zhivem",
  "license": "MIT"
}