{
  "name": "movie-search-app",
  "version": "1.0.5",
  "description": "Приложение для поиска и просмотра фильмов",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.zhive.movieapp",
    "productName": "FlickTap",
    "copyright": "Copyright © 2025 Zhivem",
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/movie.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Каталог Фильмов",
      "installerIcon": "assets/movie.ico",
      "uninstallerIcon": "assets/movie.ico",
      "installerHeaderIcon": "assets/movie.ico"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      ".env",
      "!assets/**/*.psd",
      "!assets/**/*.ai"
    ],
    "extraResources": [
      {
        "from": "assets/movie.ico",
        "to": "movie.ico"
      }
    ],
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.13.1",
    "axios": "^1.13.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2"
  },
  "author": "Zhivem",
  "license": "MIT"
}
